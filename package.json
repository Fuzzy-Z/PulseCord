{
  "name": "pulsecord",
  "version": "1.0.0",
  "description": "Discord Clone Desktop App with Voice, Screen Share, Roles, and Music Bot",
  "main": "electron/main.js",
  "author": "PulseCord Team",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev:server": "node server/index.js",
    "build:vite": "vite build",
    "dev": "node scripts/dev.js",
    "build": "vite build && electron-builder --win portable --dir",
    "dist:exe": "vite build && electron-builder --win portable",
    "dist:installer": "vite build && electron-builder --win nsis",
    "server": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.pulsecord.app",
    "productName": "PulseCord",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
