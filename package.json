{
  "name": "pulsecord",
  "version": "1.0.36",
  "description": "Discord Clone Desktop App with Voice, Screen Share, Roles, and Music Bot",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "PulseCord Team",
  "license": "MIT",
  "scripts": {
    "start": "node server/index.js",
    "dev:vite": "vite",
    "dev:server": "node server/index.js",
    "build:vite": "vite build",
    "dev": "node scripts/dev.js",
    "build": "vite build && electron-builder --win portable --dir",
    "dist:exe": "vite build && electron-builder --win portable",
    "dist:installer": "vite build && electron-builder --win nsis",
    "publish-update": "node scripts/publish-update.js",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@upstash/redis": "^1.34.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.16.0",
    "play-dl": "^1.9.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-player": "^2.16.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.voxel.app",
    "productName": "Voxel",
    "icon": "public/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
